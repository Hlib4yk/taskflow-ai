generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  // "native" covers local dev (macOS/Linux glibc); the musl target is the
  // Docker runtime (node:20-alpine, OpenSSL 3.x) — without it Prisma falls
  // back to guessing the OpenSSL version at runtime and gets it wrong.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("GATEWAY_DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  passwordHash  String
  createdAt     DateTime       @default(now())
  refreshTokens RefreshToken[]
}

// Rotated on every /auth/refresh call; `familyId` links a chain of tokens
// descended from one login so that reuse of an already-rotated token (a
// strong signal of theft) can revoke the whole chain at once.
model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId          String
  revokedAt         DateTime?
  replacedByTokenId String?
  expiresAt         DateTime
  createdAt         DateTime  @default(now())

  @@index([familyId])
  @@index([userId])
}
