# ---- Shared ----
NODE_ENV=development

# ---- Postgres (shared instance, one logical DB per service) ----
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
GATEWAY_DATABASE_URL=postgresql://taskflow:taskflow@postgres:5432/authdb
TASKS_DATABASE_URL=postgresql://taskflow:taskflow@postgres:5432/tasksdb

# ---- Redis (cache, rate-limit, BullMQ) ----
REDIS_URL=redis://redis:6379

# ---- RabbitMQ (event bus between services) ----
RABBITMQ_URL=amqp://taskflow:taskflow@rabbitmq:5672
RABBITMQ_USER=taskflow
RABBITMQ_PASSWORD=taskflow

# ---- Qdrant (vector store for RAG) ----
QDRANT_URL=http://qdrant:6333

# ---- Observability (OpenTelemetry traces -> otel-collector -> Jaeger) ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- LLM provider (Anthropic Claude) ----
ANTHROPIC_API_KEY=sk-ant-xxxxx
LLM_MODEL=claude-sonnet-5

# ---- Service URLs (used by gateway to reach internal services) ----
TASKS_SERVICE_URL=http://tasks-service:3001
AI_SERVICE_URL=http://ai-service:3002
NOTIFICATIONS_SERVICE_URL=http://notifications-service:3003

# ---- Ports ----
GATEWAY_PORT=3000
TASKS_SERVICE_PORT=3001
AI_SERVICE_PORT=3002
NOTIFICATIONS_SERVICE_PORT=3003
WEB_PORT=3100

# ---- Frontend (public) ----
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_NOTIFICATIONS_URL=http://localhost:3003
